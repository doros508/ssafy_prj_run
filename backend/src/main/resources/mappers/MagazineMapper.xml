<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mrt.mvc.model.dao.MagazineDao">

	<!-- 매거진 전체 조회 -->
	<select id="selectAll" resultType="Magazine" parameterType="SearchCondition">
		SELECT magazine_no, magazine_title, magazine_reg_date, magazine_view_cnt, magazine_thumbnail
		FROM magazine
		<if test="key != null">
	    	WHERE ${key} LIKE concat('%',#{word},'%')
	    </if>
	    <if test="orderBy != null">
	    	ORDER BY ${orderBy} ${orderByDir}
	    </if>
	</select>
	
	<!-- 게시글 상세 조회 -->
	<select id="selectOne" resultType="Magazine" parameterType="int">
		SELECT *
		FROM magazine
		WHERE magazine_no = #{no}
	</select>
	
	<!-- 조회수 증가 -->
	<update id="updateViewCnt" parameterType="int">
		UPDATE magazine
		SET magazine_view_cnt = magazine_view_cnt + 1
		WHERE magazine_no = #{no}
	</update>
	
